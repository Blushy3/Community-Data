/* Community Hub — Brutalist/Torn Paper Design */@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap');:root{  --bg:#090a0a;--paper:#121314;--ink:#f0f0ee;--ink-dim:#989a9c;  --accent:#ff6b3d;--accent-2:#66ffcc;--border:3px;  --font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',monospace;  --container:1120px;--header-h:68px;--t:220ms;--ease:cubic-bezier(0.33,1,0.68,1);}*,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:var(--font);font-size:1rem;line-height:1.6;color:var(--ink);background:var(--bg)}img{max-width:100%;display:block}a{color:var(--accent);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:2px}a:hover{color:var(--accent-2)}h1,h2,h3,h4{font-weight:900;margin:0;text-transform:uppercase;letter-spacing:-0.03em;color:var(--ink)}h1{font-size:clamp(2.5rem,8vw,5rem);line-height:.9}h2{font-size:clamp(2rem,5vw,3rem);line-height:1}h3{font-size:1.5rem;line-height:1.1}button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}::selection{background:var(--accent);color:var(--bg)}:focus-visible{outline:3px solid var(--accent)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}.skip-link{position:fixed;top:-100%;left:1rem;z-index:9999;background:var(--ink);color:var(--bg);padding:.5rem 1rem;font-weight:800;text-transform:uppercase;border:3px solid var(--ink)}.skip-link:focus{top:1rem}.container{max-width:var(--container);margin:0 auto;padding:0 1.25rem}main{padding-top:var(--header-h);min-height:70vh}/* ===== PAGE HEADER ===== */.page-header{padding:4rem 0 2rem;border-bottom:3px solid var(--ink);margin-bottom:2rem}.page-header h1{font-size:clamp(2.2rem,6vw,4rem);margin-bottom:.5rem}.page-header p{color:var(--ink-dim);font-size:1.05rem;max-width:600px;margin:0;text-transform:none;font-weight:400}/* ===== HEADER ===== */.site-header{position:fixed;top:0;left:0;right:0;height:var(--header-h);z-index:1000;background:var(--bg);border-bottom:3px solid var(--ink)}.header-inner{max-width:var(--container);margin:0 auto;padding:0 1.25rem;height:100%;display:flex;align-items:center;gap:2rem}.brand{font-size:1.1rem;font-weight:900;color:var(--ink);text-transform:uppercase;letter-spacing:.1em;text-decoration:none}.brand:hover{color:var(--accent);text-decoration:none}.main-nav{display:flex;gap:.25rem}.main-nav a{padding:.5rem 1rem;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-dim);text-decoration:none;transition:color var(--t),background var(--t)}.main-nav a:hover,.main-nav a[aria-current=page]{color:var(--ink);background:var(--paper)}.header-actions{margin-left:auto;display:flex;align-items:center;gap:.75rem}/* ===== LANG SWITCH ===== */.lang-switch{position:relative}.lang-btn{display:flex;align-items:center;gap:.35rem;padding:.4rem .75rem;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-dim);border:3px solid var(--ink);background:transparent;transition:all var(--t)}.lang-btn:hover{color:var(--ink);background:var(--paper)}.lang-menu{position:absolute;top:calc(100%+.4rem);right:0;min-width:120px;background:var(--paper);border:3px solid var(--ink);padding:.35rem;opacity:0;pointer-events:none;transform:translateY(-4px);transition:all var(--t)}.lang-switch:hover .lang-menu,.lang-switch:focus-within .lang-menu{opacity:1;pointer-events:auto;transform:translateY(0)}.lang-menu button{display:block;width:100%;text-align:left;padding:.4rem .75rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-dim);transition:all var(--t)}.lang-menu button:hover{color:var(--ink);background:var(--bg)}.lang-menu button[aria-pressed=true]{color:var(--accent)}/* ===== BUTTONS ===== */.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.5rem;font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;border:3px solid var(--ink);transition:all var(--t);text-decoration:none}.btn:hover{transform:translateY(-2px);box-shadow:4px 4px 0 var(--ink);text-decoration:none}.btn-accent{background:var(--accent);color:var(--bg);border-color:var(--accent)}.btn-accent:hover{box-shadow:4px 4px 0 var(--accent)}.btn-ghost{background:transparent;color:var(--ink)}.btn-ghost:hover{background:var(--paper)}/* ===== HERO ===== */.hero{padding:5rem 0 3rem;border-bottom:3px solid var(--ink);margin-bottom:2rem}.hero h1{font-size:clamp(3rem,10vw,7rem);line-height:.85;margin-bottom:1.5rem}.hero .tagline{font-size:1rem;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.15em;font-weight:400;max-width:640px;margin:0 0 1.5rem}.hero-ctas{display:flex;flex-wrap:wrap;gap:1rem}/* ===== SECTION ===== */.section{padding:4rem 0;border-bottom:3px dashed var(--ink-dim)}.section-title{font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:2rem;display:flex;align-items:baseline;gap:1rem}.section-title .num{font-size:1rem;font-weight:400;color:var(--accent);letter-spacing:0}/* ===== GRID ===== */.grid{display:grid;gap:1.25rem}.grid-2{grid-template-columns:repeat(2,1fr)}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-4{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}/* ===== CARDS (torn edges) ===== */.card{background:var(--paper);border:3px solid var(--ink);padding:1.5rem;transition:all var(--t);clip-path:polygon(0 0,100% 0,99% 97%,97% 100%,3% 99%,0 96%)}.card:hover{transform:translateY(-3px);box-shadow:6px 6px 0 rgba(255,255,255,.08)}.user-card{display:flex;flex-direction:column;gap:1rem}.user-card .avatar{width:64px;height:64px;border:3px solid var(--ink);object-fit:cover;background:var(--bg)}.user-card h3{font-size:1.3rem}.user-card .role{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--accent)}.user-card .bio{color:var(--ink-dim);font-size:.85rem;flex:1;margin:0;text-transform:none;font-weight:400}.user-card .meta{display:flex;gap:.75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;color:var(--ink-dim)}/* ===== ACHIEVEMENT CARD ===== */.ach-card{padding:1.5rem;clip-path:polygon(0 0,100% 0,98% 98%,95% 100%,2% 99%,0 95%)}.ach-card .icon{width:48px;height:48px;border:3px solid var(--ink);object-fit:cover;margin-bottom:.75rem;background:var(--bg)}.ach-card h3{font-size:1.1rem;margin-bottom:.25rem}.ach-card p{color:var(--ink-dim);font-size:.8rem;margin:0;text-transform:none;font-weight:400}.ach-card .tags{display:flex;gap:.5rem;margin-top:.75rem}/* ===== PROJECT CARD ===== */.proj-card{padding:0 0 1.5rem;clip-path:polygon(0 0,100% 0,99% 98%,96% 100%,4% 99%,0 96%)}.proj-card .thumb{width:100%;height:160px;border-bottom:3px solid var(--ink);object-fit:cover;background:var(--bg)}.proj-card h3{font-size:1.3rem;padding:.75rem .75rem 0}.proj-card p{color:var(--ink-dim);font-size:.85rem;padding:0 .75rem;text-transform:none;font-weight:400}.proj-card .meta{display:flex;align-items:center;gap:.75rem;padding:.75rem;border-top:1px dashed var(--ink-dim);margin-top:.75rem}/* ===== BADGE ===== */.badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;padding:2px 8px;border:3px solid var(--ink);color:var(--ink);background:transparent}.badge-accent{border-color:var(--accent);color:var(--accent)}/* ===== TOOLBAR ===== */.toolbar{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-bottom:2rem}.toolbar .field{flex:1 1 200px}.toolbar input,.toolbar select{width:100%;background:var(--paper);border:3px solid var(--ink);color:var(--ink);padding:.65rem .75rem;font-family:inherit;font-size:.85rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;transition:all var(--t)}.toolbar input:focus,.toolbar select:focus{border-color:var(--accent);outline:none;box-shadow:4px 4px 0 var(--accent)}/* ===== USER ACHS ===== */.user-achs{margin-top:.75rem}.ach-minis{display:flex;flex-wrap:wrap;gap:6px}.ach-mini{width:28px;height:28px;border:3px solid var(--ink);object-fit:cover;background:var(--bg);transition:transform var(--t)}.ach-mini:hover{transform:scale(1.2)}.ach-more{font-size:.7rem;font-weight:800;color:var(--ink-dim);padding:2px 6px;border:3px solid var(--ink)}/* ===== EMPTY STATE ===== */.empty-state{text-align:center;padding:5rem 1rem;border:3px dashed var(--ink-dim);color:var(--ink-dim)}.empty-state .ic{font-size:2.5rem;margin-bottom:.75rem}/* ===== FEATURED ===== */.featured-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem}.featured-panel{background:var(--paper);border:3px solid var(--ink);padding:1.5rem;clip-path:polygon(0 0,100% 0,98% 97%,95% 100%,2% 98%,0 95%)}.featured-panel h3{font-size:1.2rem;margin-bottom:.5rem}.featured-panel p{color:var(--ink-dim);font-size:.85rem;text-transform:none;font-weight:400}/* ===== VIEW ===== */.view{padding:2rem 0}/* ===== FOOTER ===== */.site-footer{border-top:3px solid var(--ink);padding:2.5rem 0;margin-top:3rem;color:var(--ink-dim);font-size:.8rem;text-transform:uppercase;letter-spacing:.05em}.site-footer .inner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}/* ===== TOAST ===== */.toast{position:fixed;bottom:130px;left:50%;transform:translateX(-50%) translateY(120%);background:var(--paper);border:3px solid var(--ink);padding:1rem 1.5rem;z-index:3000;opacity:0;pointer-events:none;transition:all .35s var(--ease);text-align:center;min-width:320px}.toast.show{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}.toast h4{font-size:1rem;margin-bottom:.25rem}.toast p{margin:0;color:var(--ink-dim);font-size:.85rem;text-transform:none;font-weight:400}/* ===== DOCK ===== */.dock{position:fixed;left:50%;bottom:0;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;align-items:center;padding-top:24px;user-select:none}.dock-bar{display:flex;align-items:flex-end;gap:8px;padding:10px 14px;background:var(--bg);border:3px solid var(--ink);transform:translateY(calc(100% + 24px));transition:transform .35s var(--ease)}.dock:hover .dock-bar,.dock.active .dock-bar{transform:translateY(0)}.dock-grab{position:fixed;bottom:6px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;z-index:2001;pointer-events:auto;cursor:pointer;transition:all var(--t)}.dock-arrow{font-size:1.1rem;display:inline-block;animation:swipeBounce 1.2s ease-in-out infinite}.dock-hint{font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-dim)}.dock:hover .dock-grab,.dock.active .dock-grab{bottom:16px}.dock:hover .dock-hint,.dock.active .dock-hint{color:var(--accent)}@keyframes swipeBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}.dock:hover .dock-grab,.dock.active .dock-grab{color:var(--accent);bottom:16px}.dock-item{display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--ink);padding:4px;transition:transform var(--t) var(--ease);transform-origin:bottom center;text-decoration:none}.dock-item:hover{text-decoration:none}.dock-ic{width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;background:var(--paper);border:3px solid var(--ink);transition:all var(--t)}.dock-item:hover .dock-ic{transform:scale(1.25) translateY(-4px);border-color:var(--accent)}.dock-lbl{font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-dim);opacity:0;transform:translateY(3px);transition:all var(--t);white-space:nowrap}.dock-item:hover .dock-lbl{opacity:1;transform:translateY(0);color:var(--ink)}/* ===== RESPONSIVE ===== */@media(max-width:900px){.grid-2,.grid-3{grid-template-columns:1fr}.featured-grid{grid-template-columns:1fr}}@media(max-width:620px){  .hero h1{font-size:clamp(2rem,12vw,3.5rem)}  .grid-4{grid-template-columns:1fr}  .page-header h1{font-size:clamp(1.8rem,8vw,2.5rem)}  .section{padding:2.5rem 0}  .dock-ic{width:38px;height:38px;font-size:1.1rem}  .dock-lbl{display:none}  .toast{bottom:100px;min-width:280px}}