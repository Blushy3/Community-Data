/* Vintage Film Aesthetic — Community Hub */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap');
:root{
  --bg:#f5f0e8;--surface:#ede6db;--paper:#e8e0d5;
  --ink:#2c2416;--ink-dim:#6b5d4f;--ink-muted:#9a8c7a;
  --accent:#c45a3c;--accent-2:#8b6f47;
  --border:rgba(44,36,22,0.12);--border-strong:rgba(44,36,22,0.22);
  --font:'Inter',system-ui,sans-serif;
  --serif:'EB Garamond','Georgia','Times New Roman',serif;
  --radius-sm:6px;--radius:10px;--radius-lg:16px;
  --container:1120px;--header-h:68px;
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--font);font-size:1rem;line-height:1.7;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;position:relative}
body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:0.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-size:256px 256px}
img{max-width:100%;display:block}
a{color:var(--accent);text-decoration:underline;text-underline-offset:2px;text-decoration-color:var(--border-strong);transition:all var(--t)}
a:hover{color:var(--ink);text-decoration-color:var(--accent)}
h1,h2,h3,h4{font-family:var(--serif);font-weight:500;margin:0;color:var(--ink);letter-spacing:-0.02em}
h1{font-size:clamp(2.2rem,5vw,3.5rem);font-style:italic;line-height:1.1}
h2{font-size:clamp(1.8rem,4vw,2.5rem);font-style:italic;line-height:1.15}
h3{font-size:1.35rem;line-height:1.2}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
::selection{background:rgba(196,90,60,0.25);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--radius-sm)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.skip-link{position:fixed;top:-100%;left:1rem;z-index:9999;background:var(--ink);color:var(--bg);padding:.5rem 1rem;border-radius:var(--radius-sm);font-weight:600;transition:top var(--t)}
.skip-link:focus{top:1rem}
.container{max-width:var(--container);margin:0 auto;padding:0 1.5rem}
main{padding-top:var(--header-h);min-height:70vh}
.page-header{text-align:center;padding:3.5rem 0 2.5rem;border-bottom:1px solid var(--border);margin-bottom:2rem}
.page-header h1{font-size:clamp(2rem,4vw,3rem);margin-bottom:.5rem}
.page-header p{color:var(--ink-dim);font-size:1.05rem;max-width:540px;margin:0 auto;font-family:var(--serif);font-style:italic}
.site-header{position:fixed;top:0;left:0;right:0;height:var(--header-h);z-index:1000;background:rgba(245,240,232,0.82);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.header-inner{max-width:var(--container);margin:0 auto;padding:0 1.5rem;height:100%;display:flex;align-items:center;gap:2rem}
.brand{font-family:var(--serif);font-size:1.2rem;font-style:italic;font-weight:600;color:var(--ink);text-decoration:none}
.brand:hover{color:var(--accent);text-decoration:none}
.main-nav{display:flex;gap:.25rem}
.main-nav a{padding:.5rem 1rem;border-radius:var(--radius-sm);font-size:.85rem;font-weight:500;color:var(--ink-dim);text-decoration:none;transition:all var(--t)}
.main-nav a:hover,.main-nav a[aria-current=page]{color:var(--ink);background:var(--surface)}
.header-actions{margin-left:auto;display:flex;align-items:center;gap:.75rem}
.lang-btn{display:flex;align-items:center;gap:.35rem;padding:.4rem .75rem;border-radius:var(--radius-sm);font-size:.8rem;font-weight:500;color:var(--ink-dim);border:1px solid var(--border);transition:all var(--t)}
.lang-btn:hover{color:var(--ink);border-color:var(--border-strong)}
.lang-menu{position:absolute;top:calc(100%+.4rem);right:0;min-width:120px;background:var(--bg);border:1px solid var(--border-strong);border-radius:var(--radius-sm);padding:.35rem;opacity:0;pointer-events:none;transform:translateY(-4px);transition:all var(--t)}
.lang-switch:hover .lang-menu,.lang-switch:focus-within .lang-menu{opacity:1;pointer-events:auto;transform:translateY(0)}
.lang-menu button{display:block;width:100%;text-align:left;padding:.4rem .75rem;font-size:.85rem;color:var(--ink-dim);border-radius:var(--radius-sm);transition:all var(--t)}
.lang-menu button:hover{color:var(--ink);background:var(--surface)}
.lang-menu button[aria-pressed=true]{color:var(--accent);font-weight:600}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.5rem;border-radius:var(--radius);font-weight:600;font-size:.85rem;transition:all var(--t);text-decoration:none;border:1px solid transparent}
.btn:hover{transform:translateY(-2px);text-decoration:none}
.btn-accent{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-accent:hover{background:#b04e32;box-shadow:0 4px 16px rgba(196,90,60,0.25)}
.btn-ghost{border-color:var(--border-strong);color:var(--ink);background:transparent}
.btn-ghost:hover{background:var(--surface);border-color:var(--ink-dim)}
.hero{padding:4rem 0 3rem;text-align:center}
.hero h1{margin-bottom:1rem;max-width:800px;margin-left:auto;margin-right:auto}
.hero .tagline{font-size:1.1rem;color:var(--ink-dim);font-family:var(--serif);font-style:italic;max-width:560px;margin:0 auto 1.5rem}
.hero-ctas{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center}
.section{padding:3.5rem 0;border-bottom:1px solid var(--border)}
.section-title{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:2rem;font-style:italic;color:var(--ink-dim)}
.grid{display:grid;gap:1.5rem}
.grid-2{grid-template-columns:repeat(2,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-4{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
.card{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;transition:all var(--t)}
.card:hover{transform:translateY(-3px);box-shadow:0 6px 24px rgba(44,36,22,0.08);border-color:var(--border-strong)}
.user-card{display:flex;flex-direction:column;gap:1rem}
.user-card .avatar{width:68px;height:68px;border-radius:50%;border:2px solid var(--border-strong);object-fit:cover;background:var(--surface)}
.user-card h3{font-family:var(--serif);font-size:1.3rem;font-weight:600}
.user-card .role{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--accent-2)}
.user-card .bio{color:var(--ink-dim);font-size:.88rem;margin:0;font-family:var(--serif)}
.user-card .meta{display:flex;gap:.75rem;font-size:.78rem;color:var(--ink-muted)}
.user-achs{margin-top:.75rem}
.ach-minis{display:flex;flex-wrap:wrap;gap:6px}
.ach-mini{width:30px;height:30px;border-radius:50%;border:1px solid var(--border);object-fit:cover;background:var(--surface);transition:transform var(--t)}
.ach-mini:hover{transform:scale(1.15)}
.ach-more{font-size:.7rem;font-weight:600;color:var(--ink-dim);padding:2px 8px;border:1px solid var(--border);border-radius:999px}
.badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.7rem;font-weight:600;padding:2px 10px;border-radius:999px;background:var(--surface);color:var(--ink-dim);border:1px solid var(--border)}
.badge-accent{background:rgba(139,111,71,0.1);color:var(--accent-2);border-color:rgba(139,111,71,0.2)}
.ach-card{text-align:center;padding:1.5rem;display:flex;flex-direction:column;align-items:center}
.ach-card .icon{width:52px;height:52px;border-radius:var(--radius);object-fit:cover;margin-bottom:.75rem;background:var(--surface)}
.ach-card h3{font-family:var(--serif);font-size:1.15rem;font-weight:600;margin-bottom:.25rem}
.ach-card p{color:var(--ink-dim);font-size:.85rem;margin:0;font-family:var(--serif)}
.ach-card .tags{display:flex;gap:.5rem;margin-top:.75rem;flex-wrap:wrap;justify-content:center}
.proj-card{padding:0;overflow:hidden}
.proj-card .thumb{width:100%;height:160px;object-fit:cover;background:var(--surface);border-bottom:1px solid var(--border)}
.proj-card h3{font-family:var(--serif);font-size:1.2rem;font-weight:600;padding:.75rem .75rem 0}
.proj-card p{color:var(--ink-dim);font-size:.85rem;padding:0 .75rem;font-family:var(--serif)}
.proj-card .meta{display:flex;align-items:center;gap:.75rem;padding:.75rem;border-top:1px solid var(--border);margin-top:.75rem}
.toolbar{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-bottom:2rem}
.toolbar .field{flex:1 1 200px}
.toolbar input,.toolbar select{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--ink);padding:.65rem .75rem;font-family:inherit;font-size:.85rem;transition:all var(--t)}
.toolbar input:focus,.toolbar select:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px rgba(196,90,60,0.12)}
.empty-state{text-align:center;padding:4rem 1rem;border:1px dashed var(--border);border-radius:var(--radius-lg);color:var(--ink-muted)}
.empty-state .ic{font-size:2rem;margin-bottom:.75rem}
.featured-grid{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.featured-panel{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem}
.featured-panel h3{font-family:var(--serif);font-size:1.15rem;font-style:italic}
.featured-panel p{color:var(--ink-dim);font-size:.85rem}
.view{padding:2rem 0}
.site-footer{border-top:1px solid var(--border);padding:2.5rem 0;margin-top:3rem;color:var(--ink-muted);font-size:.85rem}
.site-footer .inner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.toast{position:fixed;bottom:130px;left:50%;transform:translateX(-50%) translateY(120%);background:var(--paper);border:1px solid var(--border-strong);border-radius:var(--radius);padding:1rem 1.5rem;z-index:3000;opacity:0;pointer-events:none;transition:all .35s var(--ease);text-align:center;min-width:320px;box-shadow:0 8px 32px rgba(44,36,22,0.1)}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1;pointer-events:auto}
.toast h4{font-family:var(--serif);font-size:1.05rem;margin-bottom:.25rem}
.toast p{margin:0;color:var(--ink-dim);font-size:.85rem}
.dock{position:fixed;left:50%;bottom:0;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;align-items:center;padding-top:24px;user-select:none}
.dock-bar{display:flex;align-items:flex-end;gap:8px;padding:10px 14px;background:rgba(245,240,232,0.88);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border:1px solid var(--border-strong);border-radius:var(--radius-lg);transform:translateY(calc(100% + 24px));transition:transform .35s var(--ease)}
.dock:hover .dock-bar,.dock.active .dock-bar{transform:translateY(0)}
.dock-grab{position:fixed;bottom:6px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;z-index:2001;pointer-events:auto;cursor:pointer;transition:all var(--t)}
.dock-arrow{font-size:1rem;display:inline-block;animation:swipeBounce 1.4s ease-in-out infinite;color:var(--ink-muted)}
.dock-hint{font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted)}
.dock:hover .dock-grab,.dock.active .dock-grab{bottom:16px}
.dock:hover .dock-arrow,.dock.active .dock-arrow{color:var(--accent)}
.dock:hover .dock-hint,.dock.active .dock-hint{color:var(--ink)}
@keyframes swipeBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.dock-item{display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--ink);padding:4px;border-radius:var(--radius-sm);transition:transform var(--t) var(--ease);transform-origin:bottom center;text-decoration:none}
.dock-item:hover{text-decoration:none}
.dock-ic{width:46px;height:46px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);transition:all var(--t)}
.dock-item:hover .dock-ic{transform:scale(1.2) translateY(-4px);border-color:var(--accent-2);box-shadow:0 4px 16px rgba(44,36,22,0.08)}
.dock-lbl{font-size:.6rem;font-weight:600;color:var(--ink-muted);opacity:0;transform:translateY(3px);transition:all var(--t);white-space:nowrap;text-transform:uppercase;letter-spacing:.06em}
.dock-item:hover .dock-lbl{opacity:1;transform:translateY(0);color:var(--ink)}
@media(max-width:900px){.grid-2,.grid-3{grid-template-columns:1fr}.featured-grid{grid-template-columns:1fr}}
@media(max-width:620px){
  .hero h1{font-size:1.8rem}
  .grid-4{grid-template-columns:1fr}
  .page-header h1{font-size:1.6rem}
  .section{padding:2.5rem 0}
  .dock-ic{width:38px;height:38px;font-size:1.1rem}
  .dock-lbl{display:none}
  .toast{bottom:100px;min-width:280px}
}
