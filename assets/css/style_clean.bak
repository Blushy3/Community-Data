/* ============================================================
   Community Hub — global stylesheet
   Dark-first, atmospheric, minimal, accessible.
   Design tokens centralized at :root.
   ============================================================ */

:root {
  /* Color tokens */
  --bg: #0a0d14;
  --bg-elev: #11151f;
  --bg-elev-2: #171c29;
  --surface: rgba(255, 255, 255, 0.04);
  --surface-hover: rgba(255, 255, 255, 0.08);
  --border: rgba(255, 255, 255, 0.1);
  --border-strong: rgba(255, 255, 255, 0.18);

  --text: #eef1f7;
  --text-dim: #a5adbd;
  --text-muted: #6e7686;

  --accent: #6c8cff;
  --accent-2: #37d0b6;
  --accent-glow: rgba(108, 140, 255, 0.35);

  /* Spatial tokens */
  --radius-sm: 8px;
  --radius: 14px;
  --radius-lg: 22px;

  --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.35);
  --shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 8px 40px var(--accent-glow);

  /* Typography */
  --font: "Inter", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "Cascadia Mono", monospace;

  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-md: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.5rem;
  --text-2xl: 2rem;
  --text-3xl: 2.75rem;

  /* Spacing */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.5rem;
  --space-6: 2rem;
  --space-8: 3rem;
  --space-10: 4rem;

  /* Layout */
  --container: 1120px;
  --header-h: 68px;

  /* Motion */
  --t-fast: 120ms;
  --t: 220ms;
  --t-slow: 380ms;
  --ease: cubic-bezier(0.33, 1, 0.68, 1);
}

/* ---------- Reset & base ---------- */
*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--font);
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--text);
  background:
    radial-gradient(1200px 600px at 15% -10%, rgba(108, 140, 255, 0.14), transparent 60%),
    radial-gradient(1000px 500px at 100% 0%, rgba(55, 208, 182, 0.1), transparent 55%),
    var(--bg);
  background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

h1, h2, h3, h4 { line-height: 1.2; font-weight: 700; margin: 0; }

button { font-family: inherit; cursor: pointer; }

::selection { background: var(--accent); color: #fff; }

/* ---------- Accessibility: focus & reduced motion ---------- */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 4px;
}

.sr-only {
  position: absolute; width: 1px; height: 1px;
  margin: -1px; padding: 0; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ---------- Skip link ---------- */
.skip-link {
  position: fixed; top: -100%; left: var(--space-4);
  background: var(--bg-elev-2); color: var(--text);
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  z-index: 2000; transition: top var(--t);
}
.skip-link:focus { top: var(--space-2); text-decoration: none; }

/* ---------- Layout helpers ---------- */
.container {
  width: 100%; max-width: var(--container);
  margin: 0 auto; padding: 0 var(--space-5);
}

main { padding-top: var(--header-h); min-height: 70vh; }

/* ---------- Page header ---------- */
.page-header {
  padding: var(--space-10) 0 var(--space-6);
  text-align: center;
  max-width: 760px; margin: 0 auto;
}
.page-header h1 { font-size: var(--text-3xl); margin-bottom: var(--space-3); }
.page-header p { color: var(--text-dim); margin: 0; font-size: var(--text-lg); }

/* ---------- Header / nav (liquid glass) ---------- */
.site-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  height: var(--header-h);
  background: rgba(10, 13, 20, 0.45);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  backdrop-filter: blur(16px) saturate(160%);
  border-bottom: 1px solid var(--border);
}
.site-header::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(110deg, transparent 20%, rgba(255,255,255,0.06) 50%, transparent 80%);
  pointer-events: none;
}
.header-inner {
  height: var(--header-h);
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
}
.brand { display: flex; align-items: center; gap: var(--space-2); font-weight: 700; color: var(--text); }
.brand img { width: 34px; height: 34px; border-radius: 9px; object-fit: cover; }
.brand:hover { text-decoration: none; }

.main-nav ul { display: flex; list-style: none; margin: 0; padding: 0; gap: var(--space-1); }
.main-nav a {
  color: var(--text-dim); font-weight: 500;
  padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm);
  transition: color var(--t), background var(--t);
}
.main-nav a:hover { color: var(--text); background: var(--surface); text-decoration: none; }
.main-nav a[aria-current="page"] { color: var(--accent); background: var(--surface); }

.header-actions { display: flex; align-items: center; gap: var(--space-3); }

/* Language switcher */
.lang-switch {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0;
}
.lang-btn {
  display: flex; align-items: center; gap: var(--space-2);
  background: transparent; border: none; color: var(--text);
  padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm);
  font-weight: 600; font-size: var(--text-sm);
}
.lang-btn .caret { font-size: 0.7em; opacity: 0.8; }
.lang-menu {
  position: absolute; right: 0; top: calc(100% + var(--space-2));
  min-width: 150px;
  background: var(--bg-elev-2);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--space-1);
  opacity: 0; visibility: hidden; transform: translateY(-6px);
  transition: opacity var(--t), transform var(--t), visibility var(--t);
  z-index: 20;
}
.lang-switch.open .lang-menu { opacity: 1; visibility: visible; transform: translateY(0); }
.lang-menu button {
  display: flex; align-items: center; gap: var(--space-2);
  width: 100%; text-align: left;
  background: transparent; border: none; color: var(--text-dim);
  padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm);
  font-size: var(--text-sm);
}
.lang-menu button:hover { background: var(--surface); color: var(--text); }
.lang-menu button[aria-pressed="true"] { color: var(--accent); font-weight: 700; }

/* CTA buttons */
.btn {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  font-weight: 600; font-size: var(--text-sm);
  transition: transform var(--t) var(--ease), box-shadow var(--t), background var(--t), border-color var(--t);
}
.btn:hover { text-decoration: none; transform: translateY(-1px); }
.btn:active { transform: translateY(0); }

.btn-accent {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #071018;
  box-shadow: var(--shadow-glow);
}
.btn-accent:hover { box-shadow: 0 12px 50px var(--accent-glow); filter: brightness(1.05); }

.btn-ghost {
  background: var(--surface);
  border-color: var(--border-strong);
  color: var(--text);
}
.btn-ghost:hover { background: var(--surface-hover); box-shadow: var(--shadow-sm); }

/* Burger (mobile) */
.burger {
  display: none; flex-direction: column; gap: 5px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: var(--space-3);
}
.burger span { width: 18px; height: 2px; background: var(--text); border-radius: 2px; transition: transform var(--t), opacity var(--t); }

@media (max-width: 820px) {
  .burger { display: flex; }
  .main-nav {
    position: fixed; top: var(--header-h); left: 0; right: 0;
    background: rgba(10,13,20,0.96);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    transform: translateY(-130%); opacity: 0;
    transition: transform var(--t-slow) var(--ease), opacity var(--t-slow);
  }
  .main-nav.open { transform: translateY(0); opacity: 1; }
  .main-nav ul { flex-direction: column; padding: var(--space-3) var(--space-5) var(--space-5); }
  .main-nav a { display: block; }
}

/* ---------- Hero (home) ---------- */
.hero {
  display: flex; flex-direction: column; align-items: center; text-align: center;
  gap: var(--space-5);
  padding: var(--space-10) 0 var(--space-8);
}
.hero .logo-badge { width: 84px; height: 84px; border-radius: 24px; object-fit: cover; box-shadow: var(--shadow-glow); }
.hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); letter-spacing: -0.02em; }
.hero .tagline { font-size: var(--text-lg); color: var(--text-dim); max-width: 640px; margin: 0; }
.hero .intro { color: var(--text-muted); max-width: 560px; margin: 0; }

.hero-ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; margin-top: var(--space-2); }

/* ---------- Sections ---------- */
.section { padding: var(--space-8) 0; }
.section-title {
  font-size: var(--text-2xl); margin-bottom: var(--space-5);
  display: flex; align-items: center; gap: var(--space-3);
}
.section-title::after {
  content: ""; flex: 1; height: 1px;
  background: linear-gradient(90deg, var(--border-strong), transparent);
}

/* ---------- Cards / grids ---------- */
.grid { display: grid; gap: var(--space-5); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }

.card {
  background: linear-gradient(160deg, var(--surface), rgba(255,255,255,0.02));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: var(--space-5);
  transition: transform var(--t) var(--ease), border-color var(--t), box-shadow var(--t);
}
.card:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow);
}

/* User card */
.user-card { display: flex; flex-direction: column; gap: var(--space-3); }
.user-card .avatar {
  width: 72px; height: 72px; border-radius: 50%;
  object-fit: cover; border: 2px solid var(--border-strong);
  background: var(--bg-elev);
}
.user-card h3 { font-size: var(--text-lg); }
.user-card .role {
  font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--accent); font-weight: 700;
  margin-top: -4px;
}
.user-card .bio { color: var(--text-dim); font-size: var(--text-sm); flex: 1; margin: 0; }
.user-card .meta { display: flex; gap: var(--space-3); font-size: var(--text-xs); color: var(--text-muted); }

.badge {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-xs); font-weight: 600;
  padding: 2px var(--space-2); border-radius: 999px;
  border: 1px solid var(--border); color: var(--text-dim);
  background: var(--surface);
}
.badge-accent { color: var(--accent-2); border-color: rgba(55,208,182,0.35); }

/* Achievement card */
.ach-card { text-align: center; align-items: center; }
.ach-card .icon {
  width: 64px; height: 64px; margin: 0 auto var(--space-3);
  border-radius: 16px; object-fit: cover;
}
.ach-card h3 { font-size: var(--text-lg); }
.ach-card p { color: var(--text-dim); font-size: var(--text-sm); }
.ach-card .tags { display: flex; gap: var(--space-2); justify-content: center; flex-wrap: wrap; margin-top: var(--space-2); }

/* Project card */
.proj-card .thumb { width: 100%; height: 150px; object-fit: cover; border-radius: var(--radius-sm); background: var(--bg-elev); }
.proj-card h3 { font-size: var(--text-lg); }
.proj-card p { color: var(--text-dim); font-size: var(--text-sm); flex: 1; }
.proj-card .meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-3); }

/* ---------- Toolbar (search/filters) ---------- */
.toolbar { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-bottom: var(--space-5); }
.toolbar .field { position: relative; flex: 1 1 220px; }
.toolbar input, .toolbar select {
  width: 100%;
  background: var(--bg-elev-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  padding: var(--space-2) var(--space-4);
  font-family: inherit; font-size: var(--text-sm);
}
.toolbar input:focus, .toolbar select:focus { border-color: var(--accent); outline: none; }
.toolbar select { appearance: none; }

/* ---------- Empty / error states ---------- */
.empty-state {
  text-align: center; padding: var(--space-10) var(--space-5);
  border: 1px dashed var(--border); border-radius: var(--radius-lg);
  color: var(--text-muted);
}
.empty-state .ic { font-size: var(--text-2xl); margin-bottom: var(--space-2); }

/* ---------- Featured home panels ---------- */
.featured-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
.featured-panel h3 { font-size: var(--text-lg); }
.featured-panel .thumb { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; background: var(--bg-elev); margin-bottom: var(--space-3); }
.featured-panel p { color: var(--text-dim); font-size: var(--text-sm); }
.featured-panel .cta { margin-top: var(--space-2); font-size: var(--text-sm); }

/* ---------- Footer ---------- */
.site-footer {
  margin-top: var(--space-8);
  border-top: 1px solid var(--border);
  background: linear-gradient(180deg, transparent, rgba(255,255,255,0.02));
  padding: var(--space-6) 0;
  color: var(--text-muted); font-size: var(--text-sm);
}
.site-footer .inner { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; justify-content: space-between; }

/* ---------- Toast (coming soon) ---------- */
.toast {
  position: fixed; bottom: 130px; left: 50%;
  transform: translateX(-50%) translateY(140%);
  background: var(--bg-elev-2);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: var(--space-4) var(--space-5);
  min-width: min(90vw, 380px);
  z-index: 3000;
  opacity: 0;
  pointer-events: none;
  transition: transform var(--t-slow) var(--ease), opacity var(--t-slow);
}
.toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.toast h4 { margin: 0 0 var(--space-1); font-size: var(--text-md); }
.toast p { margin: 0; color: var(--text-dim); font-size: var(--text-sm); }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .grid-3, .grid-2 { grid-template-columns: 1fr; }
}
@media (max-width: 620px) {
  .hero { padding: var(--space-8) 0 var(--space-6); }
  .grid-4 { grid-template-columns: 1fr; }
  .page-header h1 { font-size: var(--text-2xl); }
  .section { padding: var(--space-6) 0; }
}

/* ---------- App-like subpage view ---------- */
.view {
  background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: var(--space-6);
  margin-bottom: var(--space-8);
}
@media (max-width: 620px) { .view { padding: var(--space-4); } }

/* Sticky glass toolbar */
.toolbar {
  position: sticky; top: calc(var(--header-h) + 12px); z-index: 60;
  display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center;
  background: rgba(17, 21, 31, 0.82);
  -webkit-backdrop-filter: blur(12px) saturate(160%);
  backdrop-filter: blur(12px) saturate(160%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: var(--space-3);
  margin-bottom: var(--space-5);
}
.toolbar input, .toolbar select {
  background: var(--bg);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  transition: border-color var(--t), box-shadow var(--t);
}
.toolbar input:focus, .toolbar select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.toolbar .field { flex: 1 1 200px; }
.toolbar select { min-width: 150px; }

/* Card polish */
.card { position: relative; overflow: hidden; }
.card::after {
  content: ""; position: absolute; inset: 0 0 auto 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.14), transparent);
  pointer-events: none;
}
.card:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow), 0 0 0 1px rgba(108,140,255,0.18);
}

/* ---------- User card achievement preview ---------- */
.user-achs { margin-top: var(--space-3); }
.ach-minis { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
.ach-mini {
  width: 34px; height: 34px; border-radius: 10px; object-fit: cover;
  border: 1px solid var(--border-strong);
  background: var(--bg-elev);
  transition: transform var(--t) var(--ease), box-shadow var(--t);
}
.ach-mini:hover { transform: translateY(-2px) scale(1.08); box-shadow: 0 6px 16px rgba(0,0,0,0.4); }
.ach-more { font-size: var(--text-sm); font-weight: 700; color: var(--text-dim); }

/* ---------- App dock (macOS-style, floating rounded pill) ---------- */
.dock {
  position: fixed; left: 50%; bottom: 0;
  transform: translateX(-50%);
  z-index: 2000;
  display: flex; flex-direction: column; align-items: center;
  padding-top: 24px;      /* invisible trigger zone at screen edge */
  user-select: none;
}
.dock-bar {
  display: flex; align-items: flex-end; gap: 10px;
  padding: 12px 16px 8px;
  background: rgba(30, 35, 50, 0.72);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  backdrop-filter: blur(22px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24px;
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.14);
  transform: translateY(calc(100% + 24px));
  transition: transform var(--t-slow) var(--ease);
}
.dock:hover .dock-bar,
.dock.active .dock-bar { transform: translateY(0); }

/* Grab line always visible at the screen bottom edge — the hint "dock here" */
.dock-grab {
  position: fixed; bottom: 6px; left: 50%;
  transform: translateX(-50%);
  width: 48px; height: 5px;
  border: none; padding: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.25);
  pointer-events: none;
  z-index: 2001;
  transition: opacity var(--t);
}
/* When dock slides out the grab sits inside the pill */
.dock:hover .dock-grab,
.dock.active .dock-grab {
  position: static;
  width: 44px; height: 4px;
  margin: 8px auto 0;
  background: rgba(255, 255, 255, 0.2);
  transform: none;
}

.dock-item {
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  color: var(--text); padding: 4px;
  border-radius: 16px;
  transition: transform var(--t) var(--ease);
  transform-origin: bottom center;
}
.dock-item:hover { text-decoration: none; }
.dock-item .dock-ic {
  width: 50px; height: 50px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.7rem;
  background: linear-gradient(160deg, rgba(255,255,255,0.10), rgba(255,255,255,0.03));
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 15px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 6px 18px rgba(0,0,0,0.35);
}
.dock-item .dock-lbl {
  font-size: 0.68rem; color: var(--text-dim);
  opacity: 0; transform: translateY(3px);
  transition: opacity var(--t), transform var(--t);
  white-space: nowrap;
}
.dock-item:hover .dock-lbl { opacity: 1; transform: translateY(0); }

/* macOS-style magnify */
.dock-bar:hover .dock-item { transform: scale(1.05); }
.dock-bar:hover .dock-item:hover { transform: scale(1.45); }
.dock-bar:hover .dock-item:hover + .dock-item,
.dock-bar:hover .dock-item:has(+ .dock-item:hover) { transform: scale(1.22); }
.dock-bar:hover .dock-item:hover + .dock-item + .dock-item,
.dock-bar:hover .dock-item:has(+ .dock-item:hover + .dock-item) { transform: scale(1.1); }

.dock-item.dock-lang { background: transparent; border: none; cursor: pointer; }

/* Toast sits above the floating dock */
.toast { bottom: 130px; }

@media (max-width: 620px) {
  .dock-item .dock-ic { width: 42px; height: 42px; font-size: 1.4rem; }
  .dock-item .dock-lbl { display: none; }
  .toast { bottom: 100px; }
}